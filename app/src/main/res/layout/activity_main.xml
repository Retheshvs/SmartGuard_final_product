<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- ============ CHILD / TEEN / NOT VERIFIED ============ -->
    <LinearLayout
        android:id="@+id/kidView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:text="SmartGuard"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            app:drawableStartCompat="@drawable/ic_logo_mark"
            app:drawableTint="@color/text_muted" />

        <TextView
            android:id="@+id/tvKidGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvKidMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:textSize="13sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="32dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/ringKid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="1000"
                app:indicatorInset="0dp"
                app:indicatorColor="@color/primary"
                app:indicatorSize="220dp"
                app:trackColor="@color/ring_track"
                app:trackCornerRadius="8dp"
                app:trackThickness="14dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvKidMinutes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="48sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvKidMinutesLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Always available"
            android:textAppearance="@style/TextAppearance.SmartGuard.Section" />

        <LinearLayout
            android:id="@+id/rowEmergencyApps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMyApps"
            style="@style/Widget.SmartGuard.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="My apps"
            app:icon="@drawable/ic_home"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSwitchUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Switch user"
            app:icon="@drawable/ic_switch_user"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnParentPin"
            style="@style/Widget.SmartGuard.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Parent? Unlock with PIN" />
    </LinearLayout>

    <!-- ============ FIRST-TIME SETUP ============ -->
    <LinearLayout
        android:id="@+id/setupView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="SmartGuard logo"
            android:src="@drawable/ic_logo_app" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Welcome to SmartGuard"
            android:textAppearance="@style/TextAppearance.SmartGuard.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="The phone recognises who's holding it and switches to the right mode. Start by adding the parent's face."
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetupEnroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Add the parent's face"
            app:icon="@drawable/ic_face"
            app:iconGravity="textStart" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:text="Face data is encrypted and never leaves this phone"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            app:drawableStartCompat="@drawable/ic_lock"
            app:drawableTint="@color/text_muted" />
    </LinearLayout>

    <!-- ============ PARENT ============ -->
    <LinearLayout
        android:id="@+id/parentView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.SmartGuard.Title" />

            <TextView
                android:id="@+id/chipProtection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Home tab -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/tabHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="15dp"
                    android:paddingBottom="24dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        app:cardBackgroundColor="@color/primary_container"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Using the phone now"
                                android:textColor="@color/on_primary_container"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvActiveUser"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textColor="@color/on_primary_container"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvScreenTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/on_primary_container"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/qaAddFace"
                            layout="@layout/item_quick_action" />

                        <include
                            android:id="@+id/qaFamily"
                            layout="@layout/item_quick_action" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/qaAssistant"
                            layout="@layout/item_quick_action" />

                        <include
                            android:id="@+id/qaHandOver"
                            layout="@layout/item_quick_action" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="22dp"
                        android:text="Screen time today"
                        android:textAppearance="@style/TextAppearance.SmartGuard.Section" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvFamilyToday"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="5dp"
                        android:layout_marginTop="4dp"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/tvFamilyTodayEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="5dp"
                        android:layout_marginTop="8dp"
                        android:text="Add a child or teen to see their screen time here."
                        android:textColor="@color/text_muted"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Family tab -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/tabFamily"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap someone to change their screen time, apps and curfews."
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvFamily"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddMember"
                        style="@style/Widget.SmartGuard.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Add family member"
                        app:icon="@drawable/ic_person_add"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAssistantFamily"
                        style="@style/Widget.SmartGuard.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Describe a rule in plain English"
                        app:icon="@drawable/ic_chat"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChangePin"
                        style="@style/Widget.SmartGuard.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Change parent PIN"
                        app:icon="@drawable/ic_lock"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Protection tab -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/tabProtection"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="24dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/bg_card"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/bg_card_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="4dp">

                            <include
                                android:id="@+id/rowA11y"
                                layout="@layout/item_setting_row" />

                            <include
                                android:id="@+id/rowBackground"
                                layout="@layout/item_setting_row" />

                            <include
                                android:id="@+id/rowSelfHeal"
                                layout="@layout/item_setting_row" />

                            <include
                                android:id="@+id/rowDeviceOwner"
                                layout="@layout/item_setting_row" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApplyAntiBypass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Apply lockdown"
                        android:visibility="gone"
                        app:icon="@drawable/ic_lock"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReleaseDeviceOwner"
                        style="@style/Widget.SmartGuard.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Release Device Owner (undo everything)"
                        android:textColor="@color/accent_rose"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAdbGuide"
                        style="@style/Widget.SmartGuard.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="How to set up Device Owner" />

                    <TextView
                        android:id="@+id/tvModelStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        app:drawableStartCompat="@drawable/ic_lock"
                        app:drawableTint="@color/text_muted" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_surface"
            app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/parent_tabs" />
    </LinearLayout>
</FrameLayout>
