<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Hard Constraint: NO INTERNET PERMISSION IN MANIFEST -->
    <!-- SmartGuard runs 100% on-device offline with zero cloud dependency.
         tools:node="remove" strips INTERNET even if a library manifest tries to merge it in. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    
    <!-- Permission to query usage stats if needed for policy tracking -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <!-- Heads-up / full-screen "verify now" prompt when the check can't open by itself -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Keep running: vivo force-stops non-exempt apps, which also switches their accessibility off -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Stop a restricted app after sending it home -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Optional self-heal of the accessibility service. Only effective after a one-time
         `adb shell pm grant com.smartguard android.permission.WRITE_SECURE_SETTINGS` by the parent. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Package visibility (Android 11+): needed to see which apps are user-launchable (enforcement,
         management app picker) and which package is this device's home launcher. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Emergency apps: whatever calls, texts and takes photos on this device -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.provider.Telephony.SMS_DELIVER" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.android.emergency" />
        <package android:name="com.google.android.apps.safetyhub" />
        <package android:name="com.vivo.sos" />
    </queries>

    <application
        android:name=".SmartGuardApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartGuard">

        <!-- Prevent ML Kit Analytics/Telemetry from trying to use network -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="face" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="" />
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="true" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Face Enrollment (was missing -> ActivityNotFoundException crash on "Enroll Face") -->
        <activity
            android:name=".enrollment.EnrollmentActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Visible face check. Used when a background camera service isn't allowed
             (Android 14+ blocks background camera unless the app is Device Owner). -->
        <activity
            android:name=".ui.FaceCheckActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity="com.smartguard.facecheck"
            android:theme="@style/Theme.SmartGuard.FaceCheck"
            android:turnScreenOn="true" />

        <!-- Lockscreen / Verification Prompt Activity -->
        <activity
            android:name=".ui.VerificationActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.SmartGuard.Overlay" />

        <!-- Profile management (parent-gated) -->
        <activity
            android:name=".ui.manage.ProfileEditorActivity"
            android:exported="false"
            android:label="Edit Profile"
            android:windowSoftInputMode="adjustResize" />

        <!-- Parent face confirmation for every settings change -->
        <activity
            android:name=".ui.ParentConfirmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SmartGuard.FaceCheck" />

        <!-- Kid-safe home: shown when a restricted app is closed; lists only allowed apps -->
        <activity
            android:name=".ui.KidLauncherActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:taskAffinity="com.smartguard.kidhome" />

        <!-- Hand over: parent picks apps on a home-screen style grid, then the phone is pinned to them -->
        <activity
            android:name=".ui.handover.HandoverPickerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.handover.HandoverHomeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:taskAffinity="com.smartguard.handover" />

        <!-- Natural-language Policy Assistant (parent-gated) -->
        <activity
            android:name=".ui.PolicyAssistantActivity"
            android:exported="false"
            android:label="Policy Assistant" />

        <!-- Foreground Service for Camera-based Face Verification -->
        <service
            android:name=".handover.VerificationForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <!-- Always-on lightweight monitor: screen-time ticker + handover sensor (no camera held) -->
        <service
            android:name=".handover.SmartGuardMonitorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device parental identity and screen-time monitoring, fully offline." />
        </service>

        <!-- Accessibility Service for App Launch Enforcement -->
        <service
            android:name=".accessibility.SmartGuardAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Boot receiver. SCREEN_ON / USER_PRESENT are NOT delivered to manifest receivers on
             Android 8+, so unlock events are registered at runtime in SmartGuardMonitorService. -->
        <receiver
            android:name=".handover.UnlockBroadcastReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Device Admin Receiver for Anti-Bypass Layer -->
        <receiver
            android:name=".deviceowner.SmartGuardDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
